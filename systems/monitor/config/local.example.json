{
  "ep_origin": "http://localhost:4000",
  "credential_env": "EP_BACKEND_TOKEN",
  "key_env": "EP_MONITOR_SPOOL_KEY",
  "spool_dir": "/absolute/private/path/to/monitoring-spool",
  "port": 9910,
  "interval": 15,
  "max_files": 10000,
  "max_bytes": 67108864,
  "max_age": 86400,
  "probes": [
    {
      "name": "ep-readiness",
      "url": "http://localhost:4000/health/ready",
      "source_id": "REPLACE_WITH_REGISTERED_GLOBAL_SOURCE_UUID",
      "failures": 3,
      "recoveries": 3
    }
  ]
}
