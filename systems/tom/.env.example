EP_BASE_URL=http://localhost:4000
PORT=3000
# This file is documentation; export variables in your shell.

# Operator-provisioned backend secret; matches EP, never sent to browsers.
EP_BACKEND_TOKEN=
TOM_PUBLIC_BASE_URL=http://localhost:3000
# file (development default), smtp; test is test-only.
TOM_DELIVERY_METHOD=file
TOM_MAIL_FROM=tom@localhost
TOM_SMTP_HOST=
TOM_SMTP_PORT=587
TOM_SMTP_USERNAME=
TOM_SMTP_PASSWORD=
# true for implicit TLS (normally port 465); otherwise STARTTLS is required.
TOM_SMTP_SSL=false

# EP-provisioned source IDs per verified scope; see docs/monitoring.md.
# TOM_MONITORING_SOURCES_JSON={}

# Optional: otherwise backend-only EP bindings discovery is used.
# For a production queue, set a private directory and base64 random 32-byte key.
TOM_MONITOR_SPOOL_DIR=
TOM_MONITOR_SPOOL_KEY=
# Run bin/monitoring-worker separately; collector config uses the same spool/key.
