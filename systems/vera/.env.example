# Documentation only; Rails does not automatically load this file.
EP_BASE_URL=http://localhost:4000
PORT=3001
VERA_PUBLIC_BASE_URL=http://localhost:3001
TOM_BASE_URL=http://localhost:3000
# Optional override of VERA's private development credential; never use TOM's token.
# VERA_EP_BACKEND_TOKEN=
# Development default is file (private tmp/outbox); production requires SMTP.
VERA_DELIVERY_METHOD=file
VERA_MAIL_FROM=vera@localhost
# VERA_SMTP_HOST=
# VERA_SMTP_PORT=587
# VERA_SMTP_USERNAME=
# VERA_SMTP_PASSWORD=
# VERA_SMTP_SSL=false
# Installed OCR language packs; production Docker image includes Danish and English.
VERA_OCR_LANGUAGES=dan+eng
