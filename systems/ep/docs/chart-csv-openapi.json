{
  "openapi": "3.0.3",
  "info": {
    "title": "EP reviewed chart CSV transfer",
    "version": "1.0.0",
    "description": "Configuration only. See chart-csv-api.md for semantics and limits. VERA parses/encodes CSV; EP receives bounded string arrays. No journals or balances."
  },
  "security": [
    {
      "backend": [],
      "session": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/chart-imports": {
      "get": {
        "summary": "Current transfer metadata, columns, limits and permissions",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        }
      },
      "post": {
        "summary": "Store a private upload for one hour; no accepted financial changes",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "headers",
                  "records"
                ],
                "properties": {
                  "headers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 10000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/chart-export": {
      "get": {
        "summary": "One ready whole or filtered projected snapshot; columns and string rows",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source_version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/chart-imports/{import_id}": {
      "get": {
        "summary": "Read the creating identity/backend\u2019s private upload/review",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "import_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/chart-imports/{import_id}/preview": {
      "post": {
        "summary": "Validate final chart without writes and replace the review digest",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "import_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mapping"
                ],
                "properties": {
                  "mapping": {
                    "type": "object",
                    "required": [
                      "type",
                      "name",
                      "position"
                    ],
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Logical canonical column to uploaded header. Optional unmapped fields are preserved; mapped blank fields clear."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/chart-imports/{import_id}/accept": {
      "post": {
        "summary": "Atomically accept the reviewed valid plan; original receipt FinanceChartImport:accept",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "import_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer data or accepted command"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope, owner, backend or authority unavailable"
          },
          "409": {
            "description": "Chart/review/version/idempotency conflict or view pending"
          },
          "410": {
            "description": "Review expired"
          },
          "422": {
            "description": "Invalid upload or mapping"
          },
          "503": {
            "description": "View stopped"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "digest",
                  "expected_version"
                ],
                "properties": {
                  "digest": {
                    "type": "string"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
