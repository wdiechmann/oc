{
  "openapi": "3.0.3",
  "info": {
    "title": "EP unposted journal draft preparation",
    "version": "1.0.0",
    "description": "See journal-drafts-api.md. No financial posting or external execution."
  },
  "security": [
    {
      "backend": [],
      "session": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/journals": {
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "draft_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts, private review or accepted unposted draft"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Current scope/authority unavailable"
          },
          "409": {
            "description": "Version/freshness/digest/idempotency conflict"
          },
          "410": {
            "description": "Private review expired"
          },
          "422": {
            "description": "Malformed fields, amounts, dates, scope references or limits"
          },
          "503": {
            "description": "Projection stopped or unavailable"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/journals/reviews": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts, private review or accepted unposted draft"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Current scope/authority unavailable"
          },
          "409": {
            "description": "Version/freshness/digest/idempotency conflict"
          },
          "410": {
            "description": "Private review expired"
          },
          "422": {
            "description": "Malformed fields, amounts, dates, scope references or limits"
          },
          "503": {
            "description": "Projection stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "draft_id",
                  "expected_draft_version",
                  "expected_version",
                  "contexts",
                  "data"
                ],
                "properties": {
                  "draft_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "expected_draft_version": {
                    "type": "integer",
                    "minimum": 0,
                    "nullable": true
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "contexts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "setup_version",
                      "period_version",
                      "book_version",
                      "base_currency",
                      "accounting_authority"
                    ],
                    "properties": {
                      "setup_version": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "period_version": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "book_version": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "base_currency": {
                        "type": "string"
                      },
                      "accounting_authority": {
                        "type": "string"
                      }
                    }
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "posting_date",
                      "reference",
                      "lines"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "posting_date": {
                        "type": "string",
                        "format": "date"
                      },
                      "reference": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "lines": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "account_id",
                            "reference",
                            "debit_minor",
                            "credit_minor",
                            "vat_entry_id",
                            "net_minor",
                            "assessed_vat_minor"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid",
                              "nullable": true
                            },
                            "account_id": {
                              "type": "string",
                              "format": "uuid",
                              "nullable": true
                            },
                            "reference": {
                              "type": "string",
                              "maxLength": 120
                            },
                            "debit_minor": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9000000000000
                            },
                            "credit_minor": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9000000000000
                            },
                            "vat_entry_id": {
                              "type": "string",
                              "format": "uuid",
                              "nullable": true
                            },
                            "net_minor": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": -9000000000000,
                              "maximum": 9000000000000
                            },
                            "assessed_vat_minor": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": -9000000000000,
                              "maximum": 9000000000000
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/journals/reviews/{review_id}": {
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts, private review or accepted unposted draft"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Current scope/authority unavailable"
          },
          "409": {
            "description": "Version/freshness/digest/idempotency conflict"
          },
          "410": {
            "description": "Private review expired"
          },
          "422": {
            "description": "Malformed fields, amounts, dates, scope references or limits"
          },
          "503": {
            "description": "Projection stopped or unavailable"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/journals/accept": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts, private review or accepted unposted draft"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Current scope/authority unavailable"
          },
          "409": {
            "description": "Version/freshness/digest/idempotency conflict"
          },
          "410": {
            "description": "Private review expired"
          },
          "422": {
            "description": "Malformed fields, amounts, dates, scope references or limits"
          },
          "503": {
            "description": "Projection stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "review_id",
                  "digest",
                  "expected_version"
                ],
                "properties": {
                  "review_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "digest": {
                    "type": "string"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
