  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start_date",
          "end_date",
          "expected_version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Revise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start_date",
          "end_date",
          "expected_version",
          "expected_period_version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "expected_period_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Transition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "expected_period_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "expected_period_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Reopen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "expected_period_version",
          "reason"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "expected_period_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
