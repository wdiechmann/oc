          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Scope/authority unavailable"
          },
          "409": {
            "description": "Version, overlap, transition or idempotency conflict"
          },
          "422": {
            "description": "Invalid period/reason"
          },
          "503": {
            "description": "Projection unavailable/stopped"
          }
        }
      },
      "post": {
