                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Source rate limited; Retry-After: 60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; business outcome unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or view stopped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Observation"
                  },
                  {
                    "properties": {
                      "code": {
                        "enum": [
                          "delivery.attempted",
                          "delivery.provider_accepted",
                          "delivery.delivered",
                          "delivery.bounced",
                          "delivery.rejected",
                          "delivery.unknown"
                        ]
                      },
                      "related": {
                        "required": [
                          "delivery_attempt_id"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
