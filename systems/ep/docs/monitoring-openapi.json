  "components": {
    "securitySchemes": {
      "BackendToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_observation_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "enum": [
              "application.exception",
              "application.contract_invalid",
              "request.validation_rejected",
              "request.permission_denied",
              "request.conflict",
              "dependency.unavailable",
              "projection.delayed",
              "job.exhausted",
              "delivery.attempted",
              "delivery.provider_accepted",
              "delivery.delivered",
              "delivery.bounced",
              "delivery.rejected",
              "delivery.unknown",
              "condition.recovered"
            ]
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "occurrence_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "related": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "business_command_id": {
                "type": "string",
                "format": "uuid"
              },
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "delivery_attempt_id": {
                "type": "string",
                "format": "uuid"
              },
              "job_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "business_command_id",
              "event_id",
              "delivery_attempt_id",
              "job_id"
            ]
          }
        },
        "required": [
          "source_id",
          "source_observation_id",
          "code",
          "correlation_id",
          "observed_at"
        ]
      },
      "Acceptance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "format": "uuid"
          },
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "stream_version": {
            "type": "integer",
            "minimum": 1
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "issue_id",
          "command_id",
          "event_ids",
          "stream_version",
          "correlation_id",
          "replayed"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "const": "unknown"
          }
        }
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issue_id": {
            "type": "string",
            "format": "uuid"
          },
          "occasion_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "source_version": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "issue_id",
          "occasion_id",
          "source_version",
          "updated_at",
          "data"
        ]
      },
      "Freshness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pending_events": {
            "type": "integer",
            "minimum": 0
          },
          "oldest_pending_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "pending_events",
          "oldest_pending_at",
          "checked_at"
        ]
      },
      "List": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "cutoff": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "cutoff",
          "freshness"
        ]
      },
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "acknowledge"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "expected_version"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "reopen"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "expected_version"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "assign"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 1
              },
              "owner_identity_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "action",
              "expected_version",
              "owner_identity_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "resolve"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "corrected",
                  "duplicate",
                  "accepted_risk"
                ]
              }
            },
            "required": [
              "action",
              "expected_version",
              "reason"
            ]
          }
        ]
      },
      "Detail": {
        "type": "object",
        "required": [
          "status",
          "expected_version"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "pending"
            ]
          },
          "issue": {
            "$ref": "#/components/schemas/Record"
          },
          "issue_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_version": {
            "type": "integer"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        }
      },
      "CommandStatus": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "accepted"
              },
              "command_id": {
                "type": "string",
                "format": "uuid"
              },
              "command_type": {
                "type": "string"
              },
              "result": {
                "type": "object"
              }
            },
            "required": [
              "status",
              "command_id",
              "command_type",
              "result"
            ]
          }
        ]
      },
      "Catalogue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "codes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "severity": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                },
                "safe_message": {
                  "type": "string"
                }
              },
              "required": [
                "severity",
                "category",
                "outcome",
                "safe_message"
              ]
            }
          }
        },
        "required": [
          "schema_version",
          "codes"
        ]
      }
    }
  }
}
