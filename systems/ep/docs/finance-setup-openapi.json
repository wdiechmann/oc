{
  "openapi": "3.0.3",
  "info": {
    "title": "EP finance setup",
    "version": "1.0.0",
    "description": "Book-scoped configuration only. See finance-setup-api.md for authority, projection and receipt semantics."
  },
  "security": [
    {
      "backend": [],
      "session": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup": {
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/stewards": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Steward"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/bindings": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Binding"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/accounts": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/accounts/{account_id}": {
      "patch": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRevise"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Steward": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occasion_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "occasion_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AccountCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "name",
          "kind",
          "expected_version"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "posting",
              "heading",
              "total"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AccountRevise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "name",
          "kind",
          "expected_version",
          "active",
          "expected_account_version"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "posting",
              "heading",
              "total"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "expected_account_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
