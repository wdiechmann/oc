{
  "openapi": "3.0.3",
  "info": {
    "title": "EP finance setup",
    "version": "1.1.0",
    "description": "Book-scoped configuration only. See finance-setup-api.md for authority, projection and receipt semantics."
  },
  "security": [
    {
      "backend": [],
      "session": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup": {
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/stewards": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Steward"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/bindings": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Binding"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/accounts": {
      "post": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              }
            }
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "in": "query",
            "name": "source_version",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "focus_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "description": "Canonical position pages; optional source_version fences infinite scrolling to one ready projection. 409 chart_changed requires refresh."
      }
    },
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup/accounts/{account_id}": {
      "patch": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRevise"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Steward": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occasion_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "occasion_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AccountCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "expected_version",
          "position"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
            "nullable": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "header",
              "calculation",
              "posting"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "vat_code": {
            "type": "string",
            "nullable": true,
            "enum": [
              "none",
              "input",
              "output",
              null
            ]
          },
          "category": {
            "type": "string",
            "nullable": true,
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "income",
              "expenses",
              null
            ]
          },
          "formula": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "description": "Type-specific fields: header name/position; calculation name/position/formula; posting number/name/VAT/category/position. Irrelevant fields are cleared. See finance-setup-api.md."
      },
      "AccountRevise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "expected_version",
          "active",
          "expected_account_version",
          "position"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
            "nullable": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "header",
              "calculation",
              "posting"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "expected_account_version": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "vat_code": {
            "type": "string",
            "nullable": true,
            "enum": [
              "none",
              "input",
              "output",
              null
            ]
          },
          "category": {
            "type": "string",
            "nullable": true,
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "income",
              "expenses",
              null
            ]
          },
          "formula": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "description": "Type-specific fields: header name/position; calculation name/position/formula; posting number/name/VAT/category/position. Irrelevant fields are cleared. See finance-setup-api.md."
      }
    }
  }
}
