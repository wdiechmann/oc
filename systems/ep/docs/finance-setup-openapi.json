  "components": {
    "securitySchemes": {
      "backend": {
        "type": "apiKey",
        "in": "header",
        "name": "X-EP-Backend-Token"
      },
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Steward": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occasion_id",
          "active",
          "expected_version"
        ],
        "properties": {
          "occasion_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AccountCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "expected_version",
          "position"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
            "nullable": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "header",
              "calculation",
              "posting"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "vat_code": {
            "type": "string",
            "nullable": true,
            "deprecated": true,
            "description": "Compatibility code input; prefer stable catalogue IDs. See catalogues-api.md."
          },
          "category": {
            "type": "string",
            "nullable": true,
            "deprecated": true,
            "description": "Compatibility code input; prefer stable catalogue IDs. See catalogues-api.md."
          },
          "formula": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "vat_entry_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "category_entry_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "description": "Type-specific fields: header name/position; calculation name/position/formula; posting number/name/VAT/category/position. Irrelevant fields are cleared. See finance-setup-api.md."
      },
      "AccountRevise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "expected_version",
          "active",
          "expected_account_version",
          "position"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
            "nullable": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "header",
              "calculation",
              "posting"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "expected_account_version": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "vat_code": {
            "type": "string",
            "nullable": true,
            "deprecated": true,
            "description": "Compatibility code input; prefer stable catalogue IDs. See catalogues-api.md."
          },
          "category": {
            "type": "string",
            "nullable": true,
            "deprecated": true,
            "description": "Compatibility code input; prefer stable catalogue IDs. See catalogues-api.md."
          },
          "formula": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "vat_entry_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "category_entry_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "description": "Type-specific fields: header name/position; calculation name/position/formula; posting number/name/VAT/category/position. Irrelevant fields are cleared. See finance-setup-api.md."
      },
      "ReopeningAuthority": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "allow",
          "expected_version"
        ],
        "properties": {
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "allow": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CatalogueInitialize": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CatalogueCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "code",
          "name",
          "expected_version"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "vat",
              "category"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Trimmed Unicode text, including descriptive labels and spaces; no control/format characters. Unique within book and catalogue kind."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CatalogueRevise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "active",
          "expected_entry_version",
          "expected_version"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Trimmed Unicode text, including descriptive labels and spaces; no control/format characters. Unique within book and catalogue kind."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "active": {
            "type": "boolean"
          },
          "expected_entry_version": {
            "type": "integer",
            "minimum": 1
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
