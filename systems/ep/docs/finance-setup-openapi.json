    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant_id}/finance/books/{book_id}/setup": {
      "get": {
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected setup or accepted command"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Current scope or authority unavailable"
          },
          "409": {
            "description": "Revision, binding, number or idempotency conflict"
          },
          "422": {
            "description": "Invalid setup"
          },
          "503": {
            "description": "View stopped or unavailable"
          }
        }
      }
    },
