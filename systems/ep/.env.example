# Optional overrides. Phoenix does not automatically load this file.
# Defaults use your OS username, no password, localhost:5432 and separate project databases.
# Optional explicit overrides (replace YOUR_OS_USER):
# DATABASE_URL=ecto://YOUR_OS_USER@localhost:5432/sl2030_ep_dev
# TEST_DATABASE_URL=ecto://YOUR_OS_USER@localhost:5432/sl2030_ep_test
# Optional compose.yaml database instead:
# DATABASE_URL=ecto://ep:ep@127.0.0.1:55432/ep_dev
# TEST_DATABASE_URL=ecto://ep:ep@127.0.0.1:55432/ep_test
PORT=4000
# Production also requires SECRET_KEY_BASE, PHX_HOST and PHX_SERVER=true.

# Provision the same >=32-character secret separately in EP and TOM shells.
EP_BACKEND_ID=tom
EP_BACKEND_TOKEN=

# Optional JSON object of additional backend_id -> independent >=32-character secret.
# EP_BACKEND_TOKENS_JSON=
# Optional global source created with: mix ep.monitoring.source ep global
EP_MONITORING_SOURCE_ID=

# Monitoring operational services (opt-in capture/retention).
EP_MONITOR_OBSERVER=false
EP_MONITOR_RETENTION=false
EP_MONITOR_SPOOL_DIR=
EP_MONITOR_SPOOL_KEY=
# Stable secret required across backup/restore; do not rotate without migrating indexes.
EP_MONITOR_PRIVACY_KEY=
EP_MONITOR_BACKUP_KEY=
# Directory containing pg_dump/pg_restore/createdb matching the server major.
EP_MONITOR_PG_BIN=

# Development-only extra client credentials may be provisioned in ignored
# config/backend_api_tokens.json; production uses EP_BACKEND_TOKENS_JSON.
